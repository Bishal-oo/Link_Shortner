# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:   cp .env.example .env
#
# .env.example is COMMITTED to git (it documents what vars exist).
# .env is GIT-IGNORED (it holds the real values / secrets). Never commit .env.
# -----------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — used from Phase 2 onward.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# NOTE: host is "localhost" when you run the app on your machine.
# Inside docker-compose (Phase 1B) it becomes the service name "postgres".
# We publish the container on host port 5433 to avoid clashing with a natively
# installed Postgres that may already own 5432.
DATABASE_URL=postgres://linkuser:linkpass@localhost:5433/linkshortener

# Redis — used from Phase 3 onward.
# Format: redis://HOST:PORT
REDIS_URL=redis://localhost:6379

# Cache
# Seconds a cached URL lives in Redis before expiring (default 3600 = 1 hour).
CACHE_TTL_SECONDS=3600
NEGATIVE_CACHE_TTL_SECONDS=30
LOCK_TTL_MS=5000
CLICK_FLUSH_INTERVAL_MS=10000

# Rate limiting
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_ANON_MAX=60
RATE_LIMIT_APIKEY_MAX=600
